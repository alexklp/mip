<tool_call>{"name": <function-name>, "arguments": <args-dict>}</tool_call>

        {%- endif -%}
    {%- endif -%}

    {%- if message['role'] == 'assistant' and message.tool_calls is defined and message.tool_calls -%}
        {%- for tool_call in message.tool_calls %}
            {%- set call = tool_call.function if tool_call.function is defined else tool_call %}
<tool_call>{"name": "{{ call.name }}", "arguments": {{ call.arguments | tojson if call.arguments is not string else call.arguments }}}</tool_call>
        {%- endfor -%}

    {%- elif message['role'] == 'tool' -%}
<tool_response>
{{ message['content'] }}
</tool_response>

    {%- elif message['content'] is string -%}
{{ message['content'] | trim }}

    {%- else -%}
